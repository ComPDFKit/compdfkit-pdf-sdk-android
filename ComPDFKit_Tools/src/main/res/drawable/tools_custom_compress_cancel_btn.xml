<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape><solid android:color="?attr/colorPrimary"/><stroke android:width="1dp" android:color="?attr/colorAccent"/><corners android:radius="2dp"/></shape>
  </item>
  <item>
    <shape><solid android:color="?android:attr/colorBackground"/><stroke android:width="1dp" android:color="?attr/colorAccent"/><corners android:radius="2dp"/></shape>
  </item>
</selector>
